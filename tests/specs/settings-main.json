[
  {
    "name": "Settings without profile shows start prompt",
    "steps": [
      {
        "send": { "callback": "settings:main" },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Run /start to set up your profile first."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "settings timezone submenu shows options",
    "steps": [
      {
        "send": { "callback": "settings:timezone" },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Pick your timezone:"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "settings quiet hours submenu shows options",
